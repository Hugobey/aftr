{
  "expo": {
    "name": "Aftr",
    "slug": "aftr",
    "scheme": "aftr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hugoblanchart.aftr"
    },
    "android": {
      "package": "com.hugoblanchart.aftr",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-dev-client",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Aftr to access your camera to scan Dump QR codes."
        }
      ],
      "expo-asset"
    ]
  }
}