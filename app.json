{
  "expo": {
    "name": "Aftr",
    "slug": "aftr",
    "extra": {
      "eas": {
        "projectId": "a942a9de-2d01-4171-9549-58d765f17837"
      }
    },
    "scheme": "aftr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/aftr-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hugoblanchart.aftr",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hugoblanchart.aftr",
      "adaptiveIcon": {
        "foregroundImage": "./assets/aftr-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Aftr to access your camera to scan Dump QR codes."
        }
      ],
      "expo-asset",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Aftr to access photos when needed.",
          "savePhotosPermission": "Allow Aftr to save photos to your library.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
